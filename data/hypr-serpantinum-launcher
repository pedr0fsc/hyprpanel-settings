#!/usr/bin/env bash
# Serpantinum's IPC handler needs exactly 3 arguments.
# The overlay name is "launcher", not "applauncher".
set -euo pipefail
MAIN_QML="${MAIN_QML:-$HOME/.local/share/serpantinum/src/quickshell/Shell.qml}"
if [[ ! -f "$MAIN_QML" ]]; then
  MAIN_QML="$(find "$HOME/.local/share/serpantinum" -name Shell.qml 2>/dev/null | head -n 1 || true)"
fi
if [[ -z "$MAIN_QML" || ! -f "$MAIN_QML" ]]; then
  echo "hypr-serpantinum-launcher: Shell.qml not found" >&2
  exit 1
fi
exec quickshell -p "$MAIN_QML" ipc call main handleCommand toggle launcher ""
