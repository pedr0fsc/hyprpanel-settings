#!/usr/bin/env bash
# Serpantinum app launcher. The IPC target is "applauncher", not "launcher".
set -euo pipefail
QS_MANAGER="${HOME}/.local/share/serpantinum/src/scripts/qs_manager.sh"

if [[ -x "${HOME}/.local/bin/hypr-serpantinum-launcher" ]]; then
  exec "${HOME}/.local/bin/hypr-serpantinum-launcher"
fi

MAIN_QML="${MAIN_QML:-$HOME/.local/share/serpantinum/src/quickshell/Shell.qml}"
if [[ -f "$MAIN_QML" ]] && command -v quickshell >/dev/null 2>&1; then
  exec quickshell -p "$MAIN_QML" ipc call main handleCommand toggle launcher ""
fi

if command -v serpantinum >/dev/null 2>&1; then
  exec serpantinum msg toggle launcher
fi

if [[ -x "$QS_MANAGER" ]]; then
  exec "$QS_MANAGER" toggle launcher
fi

if command -v wofi >/dev/null 2>&1; then
  exec wofi --show drun
fi

echo "hypr-launcher: no launcher found (install wofi or serpantinum)" >&2
exit 1
