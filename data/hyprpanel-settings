#!/usr/bin/env bash
set -euo pipefail
export GSK_RENDERER="${GSK_RENDERER:-cairo}"

candidates=(
  "${HYPRPANEL_SHARE:-}"
  "/usr/share/hyprpanel-settings"
  "${XDG_DATA_HOME:-$HOME/.local/share}/hyprpanel-settings"
  "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/share/hyprpanel-settings"
  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
)

for dir in "${candidates[@]}"; do
  [[ -n "$dir" && -f "$dir/hyprpanel.py" ]] || continue
  exec /usr/bin/python3 "$dir/hyprpanel.py" "$@"
done

echo "hyprpanel-settings: application files not found" >&2
exit 1
